[sub_resource type="GDScript" id="GDScript_8ons7"]
resource_name = "killplayer"
script/source = "extends Area2D


func _on_body_entered(body: Node2D) -> void:
	if body.name == \"player\":
		body.die()
		visible = false
		$CollisionShape2D.disabled = true
"

