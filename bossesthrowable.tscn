[sub_resource type="GDScript" id="GDScript_jiiek"]
resource_name = "enemykillzone"
script/source = "extends Area2D





func _on_body_entered(body: Node2D) -> void:
	if body.name == \"player\":
		body.die()
		get_parent().queue_free()
"

