resource_name = "send"
script/source = "extends Area2D
@export var level: int = 2




func _on_body_entered(body: Node2D) -> void:
	if body.name == \"player\":
		var path = \"res://level_\" + str(level) + \".tscn\"
		get_tree().change_scene_to_file(path)
"

