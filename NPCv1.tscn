[ext_resource type="Texture2D" uid="uid://divk2sphin24j" path="res://e.png" id="1_1powu"]

[sub_resource type="GDScript" id="GDScript_tsws6"]
script/source = "extends StaticBody2D
@onready var e = $e
@onready var sprite = $Sprite2D
@onready var dialouge = $\"../CanvasLayer/DialogBox\"
@onready var player: CharacterBody2D = get_tree().get_first_node_in_group(\"player\")
@export var npc_name: String
@export var npc_speaktext: PackedStringArray
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	if not npc_name or not sprite or not npc_speaktext or not dialouge:
		queue_free()
	

func _process(_delta: float) -> void:
	var player_pos = player.position
	var distance = position.distance_to(player_pos)
	if distance < 28:
		e.visible = true
		var ed = Input.is_action_just_pressed(\"interact\")
		if ed:
			dialouge.display_text(npc_speaktext, npc_name, sprite.texture)
	else:
		e.visible = false
"

